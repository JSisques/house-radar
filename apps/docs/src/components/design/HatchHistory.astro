---
import './tokens.css';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<figure class="hr-ds history">
  <svg viewBox="0 0 400 120" role="img" aria-label={label}>
    <defs>
      <pattern id="hr-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(135)">
        <line x1="0" y1="0" x2="0" y2="7" stroke="var(--hr-hatch)" stroke-width="1"></line>
      </pattern>
    </defs>
    <rect x="0" y="10" width="140" height="90" fill="url(#hr-hatch)" stroke="var(--hr-hatch)" stroke-dasharray="4 3"></rect>
    <text x="70" y="60" text-anchor="middle" class="hr-mono txt">sin observar</text>
    <polyline points="140,60 220,60 220,44 320,44 320,52 390,52" fill="none" stroke="var(--hr-primary)" stroke-width="2"></polyline>
    <line x1="10" y1="100" x2="390" y2="100" stroke="var(--hr-line)"></line>
  </svg>
</figure>

<style>
  .history {
    margin: 0;
    max-width: 28rem;
    border: 1px solid var(--hr-line);
    background: var(--hr-surface);
    padding: 0.5rem;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .txt {
    font-size: 11px;
    fill: var(--hr-muted);
  }
</style>

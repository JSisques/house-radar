{
  "name": "house-radar",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "House Radar: real estate discovery and analysis platform.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.34.6"
  },
  "scripts": {
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:check": "pnpm --filter docs exec astro check",
    "docs:test": "pnpm --filter docs test",
    "docs:check-i18n": "pnpm --filter docs check:i18n",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:root": "eslint tests eslint.config.js",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck",
    "test:workspace": "node --test --test-concurrency=1 'tests/workspace/*.test.mjs'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:changed": "turbo run build test --affected",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "renovate": "44.262.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,jsonc,yaml,yml,css}": "prettier --write --ignore-unknown"
  }
}

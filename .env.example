# Copy to .env and adjust. Never commit .env.

# PostgreSQL + PostGIS
POSTGRES_USER=house_radar
POSTGRES_PASSWORD=house_radar
POSTGRES_DB=house_radar
POSTGRES_PORT=55432

# Redis
REDIS_PORT=56379

# API
PORT=3000
INGESTION_PORT=3001
DATABASE_URL=postgres://house_radar:house_radar@localhost:55432/house_radar
REDIS_URL=redis://localhost:56379

# Observability
LOG_LEVEL=info
# OTLP/HTTP collector base URL. Leave unset to skip exporting traces and metrics.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Local observability stack (`pnpm infra:up:obs`)
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_GRPC_PORT=4317
PROMETHEUS_PORT=59090
GRAFANA_PORT=3030

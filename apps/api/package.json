{
  "name": "@house-radar/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "dependencies": {
    "@house-radar/building-blocks": "workspace:*",
    "@nestjs/common": "12.6.1",
    "@nestjs/core": "12.6.1",
    "@nestjs/cqrs": "12.1.3",
    "@nestjs/platform-express": "12.6.1",
    "@nestjs/swagger": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.1",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "26.6.10",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --ignore \"**/*.spec.ts\" --ignore \"**/*.e2e-spec.ts\" --ignore \"**/*.integration-spec.ts\"",
    "dev": "pnpm build && node --watch dist/main.js",
    "start": "node dist/main.js",
    "openapi:emit": "node dist/emit-openapi.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint ."
  }
}

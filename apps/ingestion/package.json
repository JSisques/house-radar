{
  "name": "@house-radar/ingestion",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "dependencies": {
    "@nestjs/common": "12.6.1",
    "@nestjs/core": "12.6.1",
    "@nestjs/platform-express": "12.6.1",
    "@nestjs/terminus": "12.2.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/sdk-trace": "3.1.1",
    "bullmq": "6.7.10",
    "ioredis": "6.1.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@house-radar/testing": "workspace:*",
    "@nestjs/testing": "12.6.1",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "26.6.10",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --ignore \"**/*.spec.ts\" --ignore \"**/*.e2e-spec.ts\" --ignore \"**/*.integration-spec.ts\"",
    "dev": "pnpm build && node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint .",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  }
}

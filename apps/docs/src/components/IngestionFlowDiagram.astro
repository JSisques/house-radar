---
interface Props {
  title: string;
  desc: string;
}

const { title, desc } = Astro.props;
---

<figure class="ingestion-flow">
  <svg
    viewBox="0 0 900 560"
    role="img"
    aria-labelledby="ifd-title ifd-desc"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="ifd-title">{title}</title>
    <desc id="ifd-desc">{desc}</desc>
    <defs>
      <marker
        id="ifd-arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor"></path>
      </marker>
    </defs>

    <!-- Scheduler -->
    <rect class="node accent" x="300" y="16" width="300" height="56" rx="8"></rect>
    <text class="label" x="450" y="40" text-anchor="middle">Scheduler</text>
    <text class="sub" x="450" y="60" text-anchor="middle">BullMQ repeatable jobs</text>

    <line class="edge" x1="450" y1="72" x2="450" y2="108" marker-end="url(#ifd-arrow)"></line>
    <text class="edge-label" x="462" y="95">sync-source</text>

    <!-- Redis -->
    <rect class="group" x="40" y="108" width="820" height="186" rx="10"></rect>
    <text class="group-label" x="56" y="128">Redis</text>

    <rect class="node" x="70" y="140" width="240" height="60" rx="8"></rect>
    <text class="label" x="190" y="165" text-anchor="middle">queue:idealista</text>
    <text class="sub" x="190" y="185" text-anchor="middle">rate limiter</text>

    <rect class="node" x="330" y="140" width="240" height="60" rx="8"></rect>
    <text class="label" x="450" y="165" text-anchor="middle">queue:agency-x</text>
    <text class="sub" x="450" y="185" text-anchor="middle">rate limiter</text>

    <rect class="node" x="590" y="140" width="240" height="60" rx="8"></rect>
    <text class="label" x="710" y="165" text-anchor="middle">queue:manual</text>
    <text class="sub" x="710" y="185" text-anchor="middle">…</text>

    <rect class="node" x="70" y="222" width="760" height="56" rx="8"></rect>
    <text class="label" x="450" y="246" text-anchor="middle">sync-source → fan-out → fetch-listing × N</text>
    <text class="sub" x="450" y="266" text-anchor="middle">job ID: fetch.&lt;source&gt;.&lt;externalId&gt;.&lt;runId&gt;</text>

    <line class="edge" x1="320" y1="294" x2="320" y2="340" marker-end="url(#ifd-arrow)"></line>
    <text class="edge-label" x="332" y="322">consume (atomic lock)</text>

    <!-- Workers -->
    <text class="group-label" x="70" y="334">Ingestion workers (stateless replicas)</text>
    <rect class="node" x="70" y="344" width="150" height="60" rx="8"></rect>
    <text class="label" x="145" y="369" text-anchor="middle">ingestion #1</text>
    <text class="sub" x="145" y="389" text-anchor="middle">worker</text>
    <rect class="node" x="245" y="344" width="150" height="60" rx="8"></rect>
    <text class="label" x="320" y="369" text-anchor="middle">ingestion #2</text>
    <text class="sub" x="320" y="389" text-anchor="middle">worker</text>
    <rect class="node" x="420" y="344" width="150" height="60" rx="8"></rect>
    <text class="label" x="495" y="369" text-anchor="middle">ingestion #N</text>
    <text class="sub" x="495" y="389" text-anchor="middle">worker</text>

    <!-- Database -->
    <rect class="node accent" x="640" y="330" width="245" height="104" rx="8"></rect>
    <text class="label" x="762" y="356" text-anchor="middle">PostgreSQL + PostGIS</text>
    <text class="sub" x="762" y="378" text-anchor="middle">unique (source, external_id)</text>
    <text class="sub" x="762" y="396" text-anchor="middle">append-only observations</text>
    <text class="sub" x="762" y="414" text-anchor="middle">optimistic locking (Property)</text>

    <line class="edge" x1="570" y1="374" x2="640" y2="374" marker-end="url(#ifd-arrow)"></line>
    <text class="edge-label" x="605" y="364" text-anchor="middle">upsert</text>

    <!-- Connectors -->
    <line class="edge" x1="320" y1="404" x2="320" y2="466" marker-end="url(#ifd-arrow)"></line>
    <text class="edge-label" x="332" y="440">discover / fetch</text>

    <rect class="node" x="70" y="466" width="500" height="64" rx="8"></rect>
    <text class="label" x="320" y="492" text-anchor="middle">Connector adapters</text>
    <text class="sub" x="320" y="512" text-anchor="middle">port: discover() / fetch(externalId)</text>

    <line class="edge" x1="570" y1="498" x2="640" y2="498" marker-end="url(#ifd-arrow)"></line>
    <text class="edge-label" x="605" y="488" text-anchor="middle">HTTP</text>

    <rect class="node" x="640" y="466" width="245" height="64" rx="8"></rect>
    <text class="label" x="762" y="492" text-anchor="middle">External source APIs</text>
    <text class="sub" x="762" y="512" text-anchor="middle">idealista, feeds, …</text>
  </svg>
</figure>

<style>
  .ingestion-flow {
    margin: 1.5rem 0;
    color: var(--sl-color-text);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .node {
    fill: var(--sl-color-bg-nav);
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }
  .node.accent {
    stroke: var(--sl-color-accent);
    stroke-width: 2;
  }
  .group {
    fill: none;
    stroke: var(--sl-color-gray-5);
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
  }
  .edge {
    stroke: currentColor;
    stroke-width: 1.5;
  }
  text {
    fill: currentColor;
    font-family: var(--sl-font-system-mono, monospace);
  }
  .label {
    font-size: 15px;
    font-weight: 600;
  }
  .sub {
    font-size: 12.5px;
    fill: var(--sl-color-gray-2);
  }
  .group-label {
    font-size: 13px;
    fill: var(--sl-color-gray-3);
    font-family: var(--sl-font, sans-serif);
  }
  .edge-label {
    font-size: 12px;
    fill: var(--sl-color-gray-2);
    font-family: var(--sl-font, sans-serif);
  }
</style>

{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "target": "es2022",
    "parser": { "syntax": "typescript", "decorators": true },
    "transform": { "legacyDecorator": true, "decoratorMetadata": true },
    "baseUrl": ".",
    "paths": {
      "@contexts/*": ["src/contexts/*"],
      "@core/*": ["src/core/*"],
      "@shared/*": ["src/shared/*"]
    },
    "keepClassNames": true
  },
  "module": { "type": "es6", "resolveFully": true },
  "sourceMaps": true
}

---
interface Props {
  title: string;
  desc: string;
}

const { title, desc } = Astro.props;
---

<figure class="context-map">
  <svg
    viewBox="0 0 1110 630"
    role="img"
    aria-labelledby="cmd-title cmd-desc"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="cmd-title">{title}</title>
    <desc id="cmd-desc">{desc}</desc>
    <defs>
      <marker
        id="cmd-arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor"></path>
      </marker>
    </defs>

    <rect class="node" x="20" y="30" width="230" height="110" rx="8"></rect>
    <text class="label" x="135" y="66" text-anchor="middle">identity</text>
    <text class="sub" x="135" y="94" text-anchor="middle">Account</text>
    <rect class="node" x="440" y="30" width="230" height="110" rx="8"></rect>
    <text class="label" x="555" y="66" text-anchor="middle">users</text>
    <text class="sub" x="555" y="94" text-anchor="middle">UserProfile, Favorite</text>
    <text class="sub" x="555" y="114" text-anchor="middle">SavedSearch</text>
    <rect class="node" x="20" y="260" width="230" height="110" rx="8"></rect>
    <text class="label" x="135" y="296" text-anchor="middle">ingestion</text>
    <text class="sub" x="135" y="324" text-anchor="middle">Source, IngestionRun</text>
    <rect class="node accent" x="440" y="260" width="230" height="110" rx="8"></rect>
    <text class="label" x="555" y="296" text-anchor="middle">listings</text>
    <text class="sub" x="555" y="324" text-anchor="middle">Listing, Observation</text>
    <rect class="node accent" x="860" y="260" width="230" height="110" rx="8"></rect>
    <text class="label" x="975" y="296" text-anchor="middle">properties</text>
    <text class="sub" x="975" y="324" text-anchor="middle">Property</text>
    <text class="sub" x="975" y="344" text-anchor="middle">DuplicateCandidate</text>
    <rect class="node" x="860" y="500" width="230" height="110" rx="8"></rect>
    <text class="label" x="975" y="536" text-anchor="middle">geography</text>
    <text class="sub" x="975" y="564" text-anchor="middle">Municipality, Province</text>
    <path class="edge" d="M 250 85 L 440 85" fill="none" marker-end="url(#cmd-arrow)"></path>
    <text class="edge-label" x="345" y="58" text-anchor="middle">event</text>
    <text class="edge-label" x="345" y="76" text-anchor="middle">AccountCreated</text>
    <path class="edge" d="M 250 315 L 440 315" fill="none" marker-end="url(#cmd-arrow)"></path>
    <text class="edge-label" x="345" y="288" text-anchor="middle">port</text>
    <text class="edge-label" x="345" y="306" text-anchor="middle">RecordObservation</text>
    <path class="edge" d="M 670 315 L 860 315" fill="none" marker-end="url(#cmd-arrow)"></path>
    <text class="edge-label" x="765" y="228" text-anchor="middle">events</text>
    <text class="edge-label" x="765" y="247" text-anchor="middle">ListingObserved</text>
    <text class="edge-label" x="765" y="266" text-anchor="middle">ListingPriceChanged</text>
    <text class="edge-label" x="765" y="285" text-anchor="middle">ListingDisappeared</text>
    <path class="edge" d="M 670 85 L 975 85 L 975 260" fill="none" marker-end="url(#cmd-arrow)"></path>
    <text class="edge-label" x="822" y="70" text-anchor="middle">port: AssertPropertyExists</text>
    <path class="edge" d="M 975 370 L 975 500" fill="none" marker-end="url(#cmd-arrow)"></path>
    <text class="edge-label" x="963" y="440" text-anchor="end">port: ResolveMunicipality</text>
  </svg>
</figure>

<style>
  .context-map {
    margin: 1.5rem 0;
    color: var(--sl-color-text);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .node {
    fill: var(--sl-color-bg-nav);
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }
  .node.accent {
    stroke: var(--sl-color-accent);
    stroke-width: 2;
  }
  .group {
    fill: none;
    stroke: var(--sl-color-gray-5);
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
  }
  .edge {
    stroke: currentColor;
    stroke-width: 1.5;
  }
  text {
    fill: currentColor;
    font-family: var(--sl-font-system-mono, monospace);
  }
  .label {
    font-size: 19px;
    font-weight: 600;
  }
  .sub {
    font-size: 15px;
    fill: var(--sl-color-gray-2);
  }
  .group-label {
    font-size: 13px;
    fill: var(--sl-color-gray-3);
    font-family: var(--sl-font, sans-serif);
  }
  .edge-label {
    font-size: 16px;
    fill: var(--sl-color-gray-2);
    font-family: var(--sl-font, sans-serif);
  }
</style>

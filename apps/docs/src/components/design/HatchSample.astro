---
import './tokens.css';

interface Props {
  label: string;
  value?: string;
  note: string;
}

const { label, value, note } = Astro.props;
const known = value !== undefined;
---

<div class:list={['hr-ds', 'cell', { 'hr-unk': !known, unknown: !known }]}>
  <span class="label">{label}</span>
  <span class="hr-mono value">{known ? value : 'sin dato'}</span>
  <span class="hr-mono note">{note}</span>
</div>

<style>
  .cell {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--hr-line);
    background-color: var(--hr-surface);
  }
  .cell.unknown {
    border: 1px dashed var(--hr-hatch);
    background-color: transparent;
  }
  .label {
    font-size: 0.8rem;
    color: var(--hr-muted);
  }
  .value {
    font-size: 1.25rem;
    font-weight: 500;
  }
  .unknown .value {
    color: var(--hr-muted);
  }
  .note {
    font-size: 0.7rem;
    color: var(--hr-muted);
  }
</style>
